# Palantir Console Configuration

# Server
PORT=4177

# Auth (optional — enables Bearer token auth + remote access)
# Do NOT put PALANTIR_TOKEN or PALANTIR_PM_TOKEN in this file: managers can read
# the repository. Pass PALANTIR_ACTOR_TOKEN_FILE in the launcher environment;
# its mode-0600 one-shot JSON file must also live outside the repository.
# Top/Operator and Worker processes never receive either global token.
# Run-bound agent capabilities are disabled by default. Only an executor that
# puts every agent behind a separate OS-user/container boundary may opt in:
# PALANTIR_AGENT_PROCESS_ISOLATION=verified
# Do not set this for the built-in same-UID local tmux/subprocess topology.
# PALANTIR_PM_TOKEN is optional and reserved for trusted external bearer
# automation.
# The JSON object contains PALANTIR_TOKEN and PALANTIR_PM_TOKEN. It is consumed
# and unlinked before agents start. Human browser mutations remain cookie-only.
# When enabling this on an existing install, rotate PALANTIR_TOKEN at the same
# time so already-running or remote legacy workers cannot retain the old value.
# Required for remote Operators and remote workers that propose memory:
# use the Console URL reachable from the remote node (not localhost).
# PALANTIR_BASE_URL=http://console.internal:4177

# Additional allowed CLI commands (comma-separated)
# PALANTIR_ALLOWED_COMMANDS=

# Fleet heartbeat (optional — enables SSH node reachability probes)
# PALANTIR_FLEET_HEARTBEAT=1
# PALANTIR_FLEET_HEARTBEAT_INTERVAL_MS=30000

# Anthropic (optional — for Manager Session)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=

# OpenCode (legacy)
# OPENCODE_STORAGE_HOST=~/.local/share/opencode/storage
