#!/usr/bin/env node
'use strict';

const fs = require('node:fs');

const COMMIT = '0123456789012345678901234567890123456789';
let args = process.argv.slice(2);
if (args[0] === '-C') args = args.slice(2);

if (args[0] === 'clone') {
  const target = args.at(-1);
  fs.mkdirSync(`${target}/.git`, { recursive: true });
} else if (args[0] === 'rev-parse') {
  process.stdout.write(args.includes('--git-dir') ? '.git\n' : `${COMMIT}\n`);
} else if (args[0] === 'ls-remote') {
  process.stdout.write(`${COMMIT}\trefs/heads/main\n`);
} else if (args[0] === 'worktree' && args[1] === 'add') {
  const separator = args.indexOf('--');
  const target = separator >= 0 ? args[separator + 1] : args[2];
  fs.mkdirSync(target, { recursive: true });
} else if (args[0] === 'worktree' && args[1] === 'remove') {
  const target = args.at(-1);
  fs.rmSync(target, { recursive: true, force: true });
}
